  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Softskills: Comunica\xE7\xE3o clara e eficaz, criatividade na resolu\xE7\xE3o
    de problemas e na elabora\xE7\xE3o de projetos pr\xE1ticos,  aptd\xE3o no trabalho
    em equipe.\nOrganiza\xE7\xE3o e gest\xE3o de tarefas utilizando metodologias
    \xE1geis (Scrum e Kanban) no dia a dia.\nConhecimento em pacote office, facilidade
    no aprendizado e adapta\xE7\xE3o a novos desafios.\nPerfil autodidata com foco
    em desenvolvimento cont\xEDnuo e crescimento pessoal!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
